# 地図スタイル（タイル配信元）の URL。未設定なら OpenFreeMap の liberty スタイル（キー不要）。
# 例: MapTiler を使う場合（キーは MapTiler 側で許可ドメインを制限すること）
# VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_PUBLIC_KEY
VITE_MAP_STYLE_URL=

# 入力画面の「地名・住所で探す」に使うジオコーダ（Photon 互換 API）。
# 未設定なら公開 Photon (https://photon.komoot.io/api/)。空文字にすると検索機能を無効化。
# VITE_GEOCODER_URL=
